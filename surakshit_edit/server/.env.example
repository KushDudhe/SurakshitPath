PORT=5000
# PostgreSQL connection string (e.g. Neon: Connect -> Connection string, or postgresql://user:pass@localhost:5432/surakshitpath).
# Tables are created automatically on first start. Without it the API falls back to in-memory storage.
DATABASE_URL=postgresql://user:password@localhost:5432/surakshitpath
# Recommended: TomTom Routing API key. Enables real road routing using current traffic.
# Create a key at https://developer.tomtom.com/
TOMTOM_API_KEY=

# Optional fallback routing provider (real road routes, but not traffic-aware).
# Get a key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
